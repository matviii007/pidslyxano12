# Local development template. Django does not read .env files automatically;
# set these variables in your shell or IDE, or in your hosting provider's dashboard.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave DATABASE_URL empty to use the local SQLite database.
DATABASE_URL=
MEDIA_ROOT=media

# Configure these only if the application starts sending outbound email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
